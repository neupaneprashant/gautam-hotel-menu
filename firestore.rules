rules_version = '2';
// Paste into Firebase console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function adminDoc() { return /databases/$(database)/documents/admins/$(request.auth.token.email.lower()); }
    function isAdmin() { return signedIn() && exists(adminDoc()); }
    function isOwner() { return isAdmin() && get(adminDoc()).data.role == 'owner'; }

    match /menu/{doc} {
      allow read: if true;          // everyone can see the menu
      allow write: if isAdmin();    // only listed admins can change it
    }
    match /menuHistory/{id} {
      allow read, create: if isAdmin();
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();    // only the owner adds or removes admins
    }
  }
}
